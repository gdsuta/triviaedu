# Copy to .env for local development. On Hostinger, add these as environment
# variables in hPanel (Websites → your site → Node.js → Environment variables).
NODE_ENV=production
PORT=3000
APP_NAME=Trivia Education
APP_URL=https://triviaedu.com
APP_TIMEZONE=Asia/Makassar
CURRENCY=IDR

# Long random string — generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# MySQL (hPanel → Databases → Management). On Hostinger the host is usually "localhost".
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# First admin account — created automatically on the first start if no admin exists.
# You can remove ADMIN_PASSWORD after the first successful login.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
