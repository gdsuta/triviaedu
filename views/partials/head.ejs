<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' · ' : '' %><%= app.name %></title>
  <link rel="icon" href="/img/logo-mark.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css?v=1">
  <script src="/js/theme.js"></script>
</head>
<body>
<% if (user) { %>
<div class="shell">
  <aside class="sidebar" id="sidebar">
    <a class="brand" href="/portal">
      <img src="/img/logo-mark.svg" alt="" width="34" height="34">
      <span><strong>Trivia</strong> Education</span>
    </a>
    <nav>
      <% const link = (href, label, icon) => { const active = href === path || (href.length > 7 && path.startsWith(href)); %>
        <a href="<%= href %>" class="<%= active ? 'active' : '' %>"><span class="ico"><%- icon %></span><%= label %></a>
      <% } %>
      <% const I = {
        home: '<svg viewBox="0 0 24 24"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>',
        clock: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
        sheet: '<svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>',
        chart: '<svg viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>',
        user: '<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/></svg>',
        users: '<svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2 20c.8-3.5 3.5-5 7-5s6.2 1.5 7 5"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 15c2 .6 3.4 2.2 4 5"/></svg>',
        cap: '<svg viewBox="0 0 24 24"><path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c3 2.5 9 2.5 12 0v-5"/></svg>',
        check: '<svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 12l3 3 5-6"/></svg>',
        money: '<svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg>'
      }; %>
      <% if (user.role === 'tutor') { %>
        <% link('/tutor', 'Dashboard', I.home) %>
        <p class="nav-label">Teaching</p>
        <% link('/tutor/availability', 'Available Time', I.clock) %>
        <% link('/tutor/timesheet', 'Tutoring Timesheet', I.sheet) %>
        <% link('/tutor/reports', 'Progress Report', I.chart) %>
      <% } else { %>
        <% link('/admin', 'Overview', I.home) %>
        <p class="nav-label">Manage</p>
        <% link('/admin/timesheets', 'Timesheet Review', I.check) %>
        <% link('/admin/tutors', 'Tutors', I.users) %>
        <% link('/admin/students', 'Students', I.cap) %>
        <% link('/admin/reports', 'Progress Reports', I.chart) %>
        <% link('/admin/recap', 'Hours Recap', I.money) %>
      <% } %>
      <p class="nav-label">Account</p>
      <% link('/account', 'Account Settings', I.user) %>
      <form method="post" action="/logout" class="logout">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button type="submit">Sign out</button>
      </form>
    </nav>
  </aside>
  <div class="scrim" data-close-sidebar></div>
  <div class="main">
    <header class="topbar">
      <button class="icon-btn menu-btn" data-toggle-sidebar aria-label="Open menu">
        <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <h1 class="welcome">Welcome back, <%= user.name.split(' ')[0] %></h1>
      <button class="icon-btn" data-toggle-theme aria-label="Toggle dark mode">
        <svg class="sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
      </button>
      <a class="avatar" href="/account" title="<%= user.name %>"><%= user.name.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase() %></a>
    </header>
    <main class="content">
<% } else { %>
<main class="auth-wrap">
<% } %>
<% for (const f of (typeof flashes !== 'undefined' ? flashes : [])) { %>
  <div class="alert alert-<%= f.type %>" role="status"><%= f.msg %></div>
<% } %>
