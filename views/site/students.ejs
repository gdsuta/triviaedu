      <% for (const [q, who] of testimonials) { %>
        <blockquote><p>“<%= q %>”</p><cite><%= who %></cite></blockquote>
      <% } %>
    </div>
  </section>
  <section class="section">
    <h2>Schools our students attend</h2>
    <div class="school-grid">
      <% for (const [place, list] of Object.entries(schools)) { %>
        <div class="panel">
          <h3><%= place %></h3>
          <ul class="plain"><% for (const s of list) { %><li><%= s %></li><% } %></ul>
        </div>
      <% } %>
